# Environment Variables untuk ProjectSisdas
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai

# Google Sheets Integration (Opsional)
# Isi dengan JSON string dari service account credentials
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Atau gunakan path ke file credentials.json
# GOOGLE_SHEETS_CREDENTIALS_JSON=credentials.json

# ID spreadsheet Google Sheets
# GOOGLE_SHEETS_SPREADSHEET_ID=1abc123def456ghi789jkl

# Nama worksheet untuk menyimpan log
# GOOGLE_SHEETS_WORKSHEET_NAME=SearchLog

# Flask Environment
# FLASK_ENV=development